# PHP line to build the dev image against. Compose substitutes ${PHP_VER} into
# the build arg in docker-compose.yml. Must match a published GHCR tag
# (ghcr.io/6run0/freeunit-php:trixie-php<PHP_VER>): 8.3, 8.4, or 8.5.
#
# Change this and `docker compose up --build` to iterate on a different PHP line.
PHP_VER=8.4
